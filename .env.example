# Create a local file with: cp .env.example .env && chmod 600 .env
# Railway does not use this file; configure Variables in the Railway service.

# Telegram bot token from BotFather. Never paste it into chat or commit it.
TELEGRAM_BOT_TOKEN=

# Numeric owner account ID.
OWNER_ID=

# Keep false until preview replies have been reviewed.
AUTO_SEND=false

# Optional model slug available to the signed-in ChatGPT plan account.
CODEX_MODEL=

# Maximum request time in seconds.
CODEX_TIMEOUT_SECONDS=120

# Cooldown after a subscription usage limit response.
LIMIT_COOLDOWN_MINUTES=30

# Minutes the assistant waits after the owner writes in a business chat. Use 0 to disable.
OWNER_TAKEOVER_MINUTES=15

# Maximum messages retained for each chat.
HISTORY_LIMIT=30
